print(paste0("pulling worms record for ",name))
# Convert a taxon name to the most likely WORMS fields using a nested lookup result
safe_worms_details <- function(name) {
name <- clean_taxon_name(name)
if (is.na(name) || name == "") {
return(tibble(
scientificName = NA_character_,
aphiaID = NA_integer_,
taxonRank = NA_character_,
kingdom = NA_character_,
phylum = NA_character_,
class = NA_character_,
order = NA_character_,
family = NA_character_,
genus = NA_character_,
species = NA_character_,
status = NA_character_
))
}
print(paste0("pulling worms record for ",name))
rec <- tryCatch({
worrms::wm_records_names(name)
}, error = function(e) NULL)
if (is.null(rec) || length(rec) == 0) {
rec <- lookup_worms_record(name)
return(rec)
}
if (is.data.frame(rec)) {
out <- rec %>%
dplyr::select(
scientificName = scientificname,
aphiaID = aphiaID,
status,
taxonRank = rank,
kingdom,
phylum,
class,
order,
family,
genus,
species
) %>%
slice(1)
} else {
out <- lookup_worms_record(name)
}
out
}
worms_lookup <- purrr::map_dfr(species_node_key$lookup_name[1], safe_worms_details)
worms_lookup <- purrr::map_dfr(species_node_key$lookup_name, safe_worms_details)
crosswalk_all <- bind_cols(species_node_key, worms_lookup) %>%
mutate(
scientificName = coalesce(scientificName, lookup_name),
aphiaID = as.integer(aphiaID),
taxonRank = coalesce(taxonRank, source_rank),
internal_node = !str_detect(tolower(taxonRank), "species")
) %>%
select(
source,
source_code,
source_rank,
source_name,
lookup_name,
parent_code,
parent_rank,
scientificName,
aphiaID,
taxonRank,
status,
kingdom,
phylum,
class,
order,
family,
genus,
species,
internal_node
)
crosswalk_all <- crosswalk_all %>%
filter(!is.na(source_code) | !is.na(lookup_name)) %>%
distinct() %>%
arrange(source, source_code, scientificName)
