child_code = clean_taxon_name(CHILD_CODE),
parent_name = clean_taxon_name(PARENT_NAME),
child_name = clean_taxon_name(CHILD_NAME),
parent_rank = clean_taxon_name(PARENT_RANK),
child_rank = clean_taxon_name(CHILD_RANK)
) %>%
filter(!is.na(parent_code) & !is.na(child_code))
parent_child <- bind_rows(parent_child, pq_edges)
}
