#Identify which taxonomic level you would like to summarize
wsd<-read.csv("C:/Users/Jonathan.Charendoff/Documents/CoralNetCalcificationRates-main/2024_Hawaii_Cnet_cover.csv")
calc_rates <- read.csv("C:/Users/Jonathan.Charendoff/Documents/CoralNetCalcificationRates-main/CoralNet_Hawaii_Calcification_With_Bioerosion_Rates_v2.csv")
cn.lu <- read.csv("C:/Users/Jonathan.Charendoff/Documents/CoralNetCalcificationRates-main/Data/NOAA_CRED_CoralNet_labelset2.csv")
sectors<-read.csv("C:/Users/Jonathan.Charendoff/Documents/GitHub/fish-paste/data/Sectors-Strata-Areas.csv")
names(calc_rates)<-toupper(names(calc_rates))
names(cn.lu)<-toupper(names(cn.lu))
calc_rates <- inner_join(calc_rates, cn.lu)
substr(calc_rates$SHORT.CODE, 2,nchar(calc_rates$SHORT.CODE))
calc_rates$SHORT.CODE <- substr(calc_rates$SHORT.CODE, 2,nchar(calc_rates$SHORT.CODE))
wsd_long <- pivot_longer(wsd, ACBR:ZO, names_to = "SHORT.CODE", values_to = "PCT")
wsd_long$PCT <- wsd_long$PCT/100
wsd_calc <- left_join(wsd_long, calc_rates[,3:6], by="SHORT.CODE")
wsd_calc[is.na(wsd_calc$MEAN),(ncol(wsd_calc)-2):ncol(wsd_calc)] <- 0
wsd_full_calc <- wsd_calc %>%
group_by(SEC_NAME, SITE, OBS_YEAR, DATE_, REGION, ISLAND, LATITUDE, LONGITUDE, REEF_ZONE, DEPTH_BIN, Oceanography) %>%
mutate(Calc_rate = PCT*MEAN,
Calc_lwr = PCT*LOWER.BOUND,
Calc_upr = PCT*UPPER.BOUND) %>%
dplyr::summarise(TOTAL = sum(PCT), PROD = sum(Calc_rate), PROD_lwr = sum(Calc_lwr), PROD_upr = sum(Calc_upr))
View(wsd_full_calc)
